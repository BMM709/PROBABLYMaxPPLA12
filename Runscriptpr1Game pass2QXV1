-- ฟังก์ชันหาเป้าหมายที่ใกล้ที่สุด (ซอมบี้ / ผู้เล่น)
local function getClosestTarget(isZombie)
   local closest = nil
   local shortestDist = Config.LockDistance
   
   -- ค้นหาใน Workspace หรือโฟลเดอร์ซอมบี้
   for _, v in pairs(Workspace:GetDescendants()) do
      if isZombie and (v:FindFirstChild("Humanoid") and not Players:GetPlayerFromCharacter(v)) then
         local hrp = v:FindFirstChild("HumanoidRootPart")
         if hrp and LocalPlayer.Character and LocalPlayer.Character:FindFirstChild("HumanoidRootPart") then
            local dist = (hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            if dist < shortestDist then
               shortestDist = dist
               closest = hrp
            end
         end
      elseif not isZombie and v:IsA("Model") and v ~= LocalPlayer.Character then
         local player = Players:GetPlayerFromCharacter(v)
         if player and v:FindFirstChild("HumanoidRootPart") then
            local hrp = v.HumanoidRootPart
            local dist = (hrp.Position - LocalPlayer.Character.HumanoidRootPart.Position).Magnitude
            if dist < shortestDist then
               shortestDist = dist
               closest = hrp
            end
         end
      end
   end
   return closest
end

-- ลูปการทำงานล็อกเป้าหมายและยิงตรง
RunService.RenderStepped:Connect(function()
   if Config.ZombieHardLock then
      local target = getClosestTarget(true)
      if target then
         Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
      end
   elseif Config.PlayerHardLock then
      local target = getClosestTarget(false)
      if target then
         Camera.CFrame = CFrame.new(Camera.CFrame.Position, target.Position)
      end
   end
end)

